{
  "name": "sub-translator",
  "version": "1.0.2",
  "private": true,
  "description": "YouTube 双语字幕翻译 Chrome 扩展",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --dev && node tools/reload.mjs",
    "test": "node test/run.js",
    "lint": "eslint .",
    "zip": "npm run build && node tools/zip.mjs",
    "e2e": "npm run build && node test/e2e/smoke.mjs",
    "shots": "npm run build && node tools/shots.mjs",
    "keygen": "node tools/keygen.mjs",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "playwright": "^1.62.1"
  },
  "engines": {
    "node": ">=18"
  }
}
